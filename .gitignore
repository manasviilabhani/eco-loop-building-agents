__pycache__/
*.pyc
.venv/
venv/

# Scratch/debugging directory (sanity checks, smoke tests, probe scripts
# from development) -- was accidentally committed early on via `git add -A`,
# including a stale test IDF that caused a real, confusing crash later after
# the real models had moved on without it. Not part of the deliverable.
.setup/

# EnergyPlus run artifacts (bulky, regenerated by scripts)
runs/*/
!runs/.gitkeep
eplusout.*
eplusssz.*
eplusmtr.*
*.audit
*.bnd
*.eio
*.end
*.mdd
*.mtd
*.rdd
*.shd
*.dbg

# Local model/weather caches if ever fetched into the repo
*.dmg
*.pkg

.DS_Store

# Exception: keep the final comparison run's time-series data, needed for
# the hosted dashboard's charts (everything else under runs/ is regenerable
# scratch output from intermediate debugging runs).
!runs/baseline_full/
!runs/baseline_full/eplusout.csv
!runs/ai_closed_loop_full/
!runs/ai_closed_loop_full/eplusout.csv
!runs/baseline_full_hyderabad/
!runs/baseline_full_hyderabad/eplusout.csv
!runs/ai_closed_loop_full_hyderabad/
!runs/ai_closed_loop_full_hyderabad/eplusout.csv

# Local-only secrets for the live view (never commit)
.env.local
